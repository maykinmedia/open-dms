#: src/opendms/accounts/api/serializers.py:12
msgid "Username"
msgstr "gebruikersnaam"

#: src/opendms/accounts/api/serializers.py:14
msgid "Password"
msgstr "Wachtwoord wijzigen"

#: src/opendms/accounts/api/serializers.py:32
#: src/opendms/accounts/api/tests/test_views.py:25
msgid "Unable to log in with provided credentials."
msgstr "Kan niet inloggen met de opgegeven gegevens."

#: src/opendms/accounts/api/views.py:25
msgid "login"
msgstr "inloggen"

#: src/opendms/accounts/api/views.py:27
msgid "Authenticates the user, returns whoami details on successful login."
msgstr ""
"Verifieert de gebruiker en retourneert whoami-gegevens bij een succesvolle "
"login."

#: src/opendms/accounts/api/views.py:53
msgid "logout"
msgstr "uitloggen"

#: src/opendms/accounts/api/views.py:55
msgid ""
"Remove the authenticated user's ID from the request and flush their session "
"data."
msgstr ""
"Verwijdert de ID van de geauthenticeerde gebruiker uit het verzoek en wist "
"hun sessiegegevens."

#: src/opendms/accounts/api/views.py:69
msgid "whoami"
msgstr "wie ben ik"

#: src/opendms/accounts/api/views.py:70
msgid "Returns the current logged in user."
msgstr "Geeft de momenteel ingelogde gebruiker terug."

#: src/opendms/accounts/models.py:19
msgid "username"
msgstr "gebruikersnaam"

#: src/opendms/accounts/models.py:23
msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr ""
"Vereist. 150 tekens of minder. Alleen letters, cijfers en @/,/+/-/_ tekens "
"zijn toegestaan."

#: src/opendms/accounts/models.py:27
msgid "A user with that username already exists."
msgstr "Een gebruiker met deze gebruikersnaam bestaat al."

#: src/opendms/accounts/models.py:30
msgid "first name"
msgstr "voornaam"

#: src/opendms/accounts/models.py:31
msgid "last name"
msgstr "achternaam"

#: src/opendms/accounts/models.py:32
msgid "email address"
msgstr "e-mailadres"

#: src/opendms/accounts/models.py:34
msgid "staff status"
msgstr "stafstatus"

#: src/opendms/accounts/models.py:36
msgid "Designates whether the user can log into this admin site."
msgstr "Bepaalt of de gebruiker zich op deze beheerwebsite kan aanmelden."

#: src/opendms/accounts/models.py:39
msgid "active"
msgstr "actief"

#: src/opendms/accounts/models.py:42
msgid ""
"Designates whether this user should be treated as active. Unselect this "
"instead of deleting accounts."
msgstr ""
"Bepaalt of deze gebruiker als actief dient te worden behandeld. U kunt dit "
"uitvinken in plaats van een gebruiker te verwijderen."

#: src/opendms/accounts/models.py:46
msgid "date joined"
msgstr "datum toegetreden"

#: src/opendms/accounts/models.py:54
msgid "user"
msgstr "gebruiker"

#: src/opendms/accounts/models.py:55
msgid "users"
msgstr "gebruikers"

#: src/opendms/accounts/utils.py:18
msgid "You need to be superuser to create other superusers."
msgstr "U moet een supergebruiker zijn om andere supergebruikers aan te maken."

#: src/opendms/accounts/utils.py:44
msgid "You cannot create or update a user with more permissions than yourself."
msgstr ""
"U kunt geen gebruiker aanmaken of bijwerken met meer rechten dan u zelf "
"heeft."

#: src/opendms/templates/admin/base_site.html:5
#: src/opendms/templates/admin/base_site.html:24
msgid "Administration"
msgstr "Beheer"

#: src/opendms/templates/admin/base_site.html:39
msgid "View site"
msgstr "Bekijk site"

#: src/opendms/templates/admin/base_site.html:45
msgid "Account security"
msgstr "Accountbeveiliging"

#: src/opendms/templates/admin/base_site.html:48
msgid "Change password"
msgstr "Wachtwoord wijzigen"

#: src/opendms/templates/admin/base_site.html:53
msgid "Log out"
msgstr "Afmelden"

#: src/opendms/templates/hijack/contrib/admin/button.html:6
msgid "hijack"
msgstr "overnemen"

#: src/opendms/templates/hijack/contrib/admin/button.html:8
#, python-format
msgid "Hijack %(username)s"
msgstr "Inloggen als %(username)s"

#: src/opendms/templates/maykin_2fa/login.html:13
msgid "or"
msgstr "of"

#: src/opendms/templates/maykin_2fa/login.html:16
msgid "Login with organization account"
msgstr "Inloggen met organisatieaccount"

#: src/opendms/templates/maykin_2fa/login.html:25
msgid "Contact support"
msgstr "Contact opnemen met ondersteuning"
